{
  "name": "@mini-store/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env --watch src/server.js",
    "start": "node --env-file=.env src/server.js",
    "db:migrate": "node --env-file=.env scripts/migrate.js",
    "db:seed": "node --env-file=.env scripts/seed.js",
    "admin:create": "node --env-file=.env scripts/create-admin.js",
    "test": "node --env-file=.env.test --test --test-concurrency=1"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "multer": "^2.5.0",
    "mysql2": "^3.15.0",
    "sanitize-html": "^2.18.1",
    "sharp": "^0.35.5"
  }
}
